# The deterministic path is the default and needs no external API key.
LLM_MODE=deterministic

# Optional answer polishing. The agent still uses local tools for facts and actions.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional semantic retrieval. Leave blank to use the explainable lexical baseline.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Optional local SQLite location. The default is data/runtime/clickycanvas.db.
# CLICKYCANVAS_DB=data/runtime/clickycanvas.db
